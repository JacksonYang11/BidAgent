# Copy to .env locally. Never paste a real key into tracked files.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_PORT=8000
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=150
MODEL_TIMEOUT_SECONDS=300
MODEL_MAX_OUTPUT_TOKENS=16384
CHUNK_CHARACTERS=8000
TASK_MAX_MODEL_CALLS=200
TASK_MAX_TOTAL_TOKENS=2000000
OCR_ENABLED=true
